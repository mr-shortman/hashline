{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hashline",
  "version": "0.1.0",
  "identifier": "de.kalendium.Hashline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Hashline — Markdown Viewer",
        "width": 1050,
        "height": 780,
        "minWidth": 360,
        "minHeight": 320,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' hashline-image:; font-src 'self'; connect-src ipc: http://ipc.localhost; worker-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "A fast, quiet Markdown viewer for Linux",
    "longDescription": "Hashline is a local, read-only Markdown viewer with document search, an outline and automatic reloading.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mkdn", "mdwn"],
        "mimeType": "text/markdown",
        "role": "Viewer",
        "name": "Markdown"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "hashline.desktop",
        "files": {
          "/usr/share/mime/packages/de.kalendium.Hashline.xml": "hashline-mime.xml"
        }
      }
    }
  }
}
