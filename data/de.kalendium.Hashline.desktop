[Desktop Entry]
Type=Application
Name=Hashline
GenericName=Markdown Viewer
Comment=A fast, quiet Markdown viewer for Linux
Exec=hashline %f
Icon=de.kalendium.Hashline
Terminal=false
Categories=Office;Viewer;
MimeType=text/markdown;text/x-markdown;
StartupNotify=true
StartupWMClass=de.kalendium.Hashline
