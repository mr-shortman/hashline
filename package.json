{
  "name": "hashline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "node scripts/desktop-dev.mjs",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "dev:demo": "node scripts/desktop-dev.mjs --file tests/fixtures/reader.md",
    "dev:doctor": "node scripts/desktop-dev.mjs --doctor",
    "test:watch": "vitest",
    "typecheck:watch": "tsc --noEmit --watch",
    "bundle": "tauri build --bundles deb && node scripts/finalize-deb.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "fixtures": "node benchmarks/generate.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "marked": "18.0.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.5.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
